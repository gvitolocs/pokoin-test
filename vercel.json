{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/((?!__).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' https://apis.google.com https://www.gstatic.com https://www.google.com https://accounts.google.com https://pokoin.firebaseapp.com"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/tests", "permanent": false },
    { "source": "/marketplace", "destination": "https://pokoin.com/marketplace", "permanent": false },
    { "source": "/marketplace/:path*", "destination": "https://pokoin.com/marketplace/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/card-images/:path*", "destination": "https://cdn.pokoin.com/:path*" },
    { "source": "/tests", "destination": "/index.html" },
    { "source": "/tests/", "destination": "/index.html" },
    { "source": "/sanitize", "destination": "/index.html" },
    { "source": "/sanitize/", "destination": "/index.html" },
    { "source": "/espurr", "destination": "/index.html" },
    { "source": "/espurr/", "destination": "/index.html" },
    { "source": "/ocr", "destination": "/index.html" },
    { "source": "/ocr/", "destination": "/index.html" },
    { "source": "/ocr/artists", "destination": "/index.html" },
    { "source": "/ocr/artists/", "destination": "/index.html" },
    { "source": "/artwork", "destination": "/index.html" },
    { "source": "/artwork/", "destination": "/index.html" },
    { "source": "/jumbos", "destination": "/index.html" },
    { "source": "/jumbos/", "destination": "/index.html" },
    { "source": "/poko", "destination": "/index.html" },
    { "source": "/poko/", "destination": "/index.html" },
    { "source": "/poko/archive", "destination": "/index.html" },
    { "source": "/poko/archive/", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
